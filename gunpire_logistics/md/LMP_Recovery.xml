        <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'REEVALUATING'"/>
        <set_value name="global.$LMP_Ships.{$ship}.$job" exact="null"/>
        <set_value name="global.$LMP_Ships.{$ship}.$buyOrder" exact="null"/>
        <set_value name="global.$LMP_Ships.{$ship}.$deliverOrder" exact="null"/>
        <set_value name="global.$LMP_Ships.{$ship}.$sourceOffer" exact="null"/>
        <set_value name="global.$LMP_Ships.{$ship}.$targetOffer" exact="null"/>
        <set_value name="global.$LMP_Ships.{$ship}.$requestedQty" exact="null"/>
