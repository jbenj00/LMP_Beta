<?xml version="1.0" encoding="utf-8"?>
<mdscript name="LMP_Recovery" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../x4_scripting_ref/schemas/md.xsd">
  <cues>
    <cue name="LMP_Recovery_OnLoad" instantiate="true">
      <conditions>
        <event_game_loaded/>
      </conditions>
      <actions>
        <do_if value="global.$LMP_Ships?">
          <do_all exact="global.$LMP_Ships.keys.count" counter="$i">
            <set_value name="$ship" exact="global.$LMP_Ships.keys.{$i}"/>
            <do_if value="not $ship.exists">
              <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'SHIP_MISSING_RECONCILIATION_REQUIRED'"/>
              <run_actions ref="GUNPIRE_Log">
                <param name="level" value="0"/>
                <param name="component" value="'RECOVERY'"/>
                <param name="job" value="if global.$LMP_Ships.{$ship}.$job? then global.$LMP_Ships.{$ship}.$job else ''"/>
                <param name="message" value="'Ship missing on load; record and reservations retained for safe reconciliation'"/>
              </run_actions>
            </do_if>
            <do_elseif value="global.$LMP_Ships.{$ship}.$job? and global.$LMP_Ships.{$ship}.$job != ''">
              <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'RECOVERY_REQUIRED'"/>
              <run_actions ref="GUNPIRE_Log">
                <param name="level" value="0"/>
                <param name="component" value="'RECOVERY'"/>
                <param name="job" value="global.$LMP_Ships.{$ship}.$job"/>
                <param name="message" value="'Save/load requires order, cargo, and destination reconciliation; job and reservation retained for ' + $ship.idcode"/>
              </run_actions>
            </do_elseif>
          </do_all>
        </do_if>
      </actions>
    </cue>

    <!-- A completed trade is not proof of destination deposit. -->
    <cue name="LMP_OnTradeCompleted" instantiate="true">
      <conditions>
        <event_trade_completed space="player.galaxy"/>
      </conditions>
      <actions>
        <set_value name="$matched" exact="false"/>
        <do_if value="event.param2? and event.param2.exists and global.$LMP_Ships?">
          <set_value name="$eventOrder" exact="event.param2"/>
          <do_all exact="global.$LMP_Ships.keys.count" counter="$i">
            <set_value name="$ship" exact="global.$LMP_Ships.keys.{$i}"/>
            <do_if value="global.$LMP_Ships.{$ship}.$order? and global.$LMP_Ships.{$ship}.$order == $eventOrder">
              <set_value name="$job" exact="if global.$LMP_Ships.{$ship}.$job? then global.$LMP_Ships.{$ship}.$job else ''"/>
              <set_value name="$key" exact="'$' + $job"/>
              <do_if value="$job != '' and global.$LMP_Reservations?">
                <do_if value="global.$LMP_Reservations.{$key}?">
                  <do_if value="global.$LMP_Reservations.{$key}.$ship == $ship and global.$LMP_Reservations.{$key}.$job == $job and global.$LMP_Reservations.{$key}.$order == $eventOrder">
                    <set_value name="global.$LMP_Reservations.{$key}.$state" exact="'TRADE_COMPLETED_AWAITING_DEPOSIT_CONFIRMATION'"/>
                    <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'AWAITING_DEPOSIT_CONFIRMATION'"/>
                    <set_value name="$matched" exact="true"/>
                    <run_actions ref="GUNPIRE_Log">
                      <param name="level" value="0"/>
                      <param name="component" value="'RECOVERY'"/>
                      <param name="job" value="$job"/>
                      <param name="message" value="'Matched trade completion to stored ship/order/job; reservation retained pending destination deposit confirmation'"/>
                    </run_actions>
                  </do_if>
                </do_if>
              </do_if>
            </do_if>
          </do_all>
        </do_if>
        <do_if value="not $matched">
          <run_actions ref="GUNPIRE_Log">
            <param name="level" value="0"/>
            <param name="component" value="'RECOVERY'"/>
            <param name="message" value="'Unmatched trade completion ignored; no reservation released'"/>
          </run_actions>
        </do_if>
      </actions>
    </cue>

    <cue name="LMP_OnTradeCancelled" instantiate="true">
      <conditions>
        <event_trade_cancelled space="player.galaxy"/>
      </conditions>
      <actions>
        <run_actions ref="GUNPIRE_Log">
          <param name="level" value="0"/>
          <param name="component" value="'RECOVERY'"/>
          <param name="message" value="'Trade cancellation observed; event supplies a tradeoffer, not the originating ship/job/order; reservations retained for safe reconciliation'"/>
        </run_actions>
      </actions>
    </cue>
  </cues>
</mdscript>
