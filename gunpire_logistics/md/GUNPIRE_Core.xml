<?xml version="1.0" encoding="utf-8"?>
<mdscript name="GUNPIRE_Core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../x4_scripting_ref/schemas/md.xsd">
  <cues>
    <cue name="GUNPIRE_Init" instantiate="true">
      <conditions>
        <event_game_loaded/>
      </conditions>
      <actions>
        <debug_text text="'[GUNPIRE][CORE] Extension loaded. Version 100.'" chance="100"/>
        <set_value name="global.$GUNPIRE_Version" exact="100"/>
        <set_value name="global.$GUNPIRE_Enabled" exact="false"/>
        <set_value name="global.$GUNPIRE_SessionId" exact="'S' + player.age"/>
        <run_actions ref="GUNPIRE_Log">
          <param name="level" value="1"/>
          <param name="component" value="'CORE'"/>
          <param name="message" value="'Initialized. Session=' + global.$GUNPIRE_SessionId"/>
        </run_actions>
      </actions>
    </cue>

    <library name="GUNPIRE_Log" purpose="run_actions">
      <params>
        <param name="level" default="1"/>
        <param name="component" default="'CORE'"/>
        <param name="message" default="''"/>
        <param name="job" default="''"/>
      </params>
      <actions>
        <do_if value="not global.$GUNPIRE_LogLevel? or $level le global.$GUNPIRE_LogLevel">
          <set_value name="$prefix" exact="'[GUNPIRE][' + $component + ']'"/>
          <do_if value="$job != ''">
            <set_value name="$prefix" exact="$prefix + '[' + $job + ']'"/>
          </do_if>
          <debug_text text="$prefix + ' ' + $message" chance="100"/>
        </do_if>
      </actions>
    </library>

    <library name="GUNPIRE_SafetyCheckCargoEmpty" purpose="run_actions">
      <params>
        <param name="ship"/>
      </params>
      <actions>
        <!-- GT source: md/gt_trading_signals.xml checks ship.cargo.list.count.
             No positive eligibility until cargo is known empty. -->
        <do_if value="not $ship? or not $ship.exists">
          <return value="false"/>
        </do_if>
        <return value="$ship.cargo.list? and $ship.cargo.list.count == 0"/>
      </actions>
    </library>

    <!-- GT 1.0.4 md/gt_core_system.xml ProtectedOrderIDs (lines 90,133),
         including GT MK1/MK2/MK3/MK4, Miner, Explorer, and Assist/baseorder.
         Do not steal ANY Galaxy Trader default order. -->
    <library name="GUNPIRE_IsGTManagedShip" purpose="run_actions">
      <params>
        <param name="ship"/>
      </params>
      <actions>
        <do_if value="not $ship? or not $ship.exists or not $ship.defaultorder?">
          <return value="false"/>
        </do_if>
        <set_value name="$order" exact="$ship.defaultorder"/>
        <set_value name="$gtIds" exact="['GalaxyTraderMK3', 'GalaxyTraderMK4Supply', 'GalaxyTraderMK4Supply2', 'GalaxyTraderMK2', 'GalaxyTraderMK1', 'GalaxyMiner', 'GalaxyExplorer']"/>
        <do_if value="$gtIds.indexof.{$order.id}">
          <return value="true"/>
        </do_if>
        <do_if value="$order.id == 'Assist' and $order.$baseorder? and $gtIds.indexof.{$order.$baseorder.id}">
          <return value="true"/>
        </do_if>
        <return value="false"/>
      </actions>
    </library>
  </cues>
</mdscript>
