<?xml version="1.0" encoding="utf-8"?>
<mdscript name="GUNPIRE_Core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../x4_scripting_ref/schemas/md.xsd">
  <cues>
    <cue name="GUNPIRE_Init" instantiate="true">
      <conditions>
        <event_game_loaded/>
      </conditions>
      <actions>
        <debug_text text="'[GUNPIRE][CORE] Extension loaded. Version 100.'" chance="100"/>
        <set_value name="global.$GUNPIRE_Version" exact="100"/>
        <set_value name="global.$GUNPIRE_Enabled" exact="false"/>
        <set_value name="global.$GUNPIRE_SessionId" exact="'S' + player.age"/>
        <run_actions ref="GUNPIRE_Log">
          <param name="level" value="1"/>
          <param name="component" value="'CORE'"/>
          <param name="message" value="'Initialized. Session=' + global.$GUNPIRE_SessionId"/>
        </run_actions>
      </actions>
    </cue>

    <library name="GUNPIRE_Log" purpose="run_actions">
      <params>
        <param name="level" default="1"/>
        <param name="component" default="'CORE'"/>
        <param name="message" default="''"/>
        <param name="job" default="''"/>
      </params>
      <actions>
        <do_if value="not global.$GUNPIRE_LogLevel? or $level le global.$GUNPIRE_LogLevel">
          <set_value name="$prefix" exact="'[GUNPIRE][' + $component + ']'"/>
          <do_if value="$job != ''">
            <set_value name="$prefix" exact="$prefix + '[' + $job + ']'"/>
          </do_if>
          <debug_text text="$prefix + ' ' + $message" chance="100"/>
        </do_if>
      </actions>
    </library>

    <library name="GUNPIRE_SafetyCheckCargoEmpty" purpose="run_actions">
      <params>
        <param name="ship"/>
      </params>
      <actions>
        <do_if value="not $ship? or not $ship.exists or not $ship.cargo?">
          <run_actions ref="GUNPIRE_Log">
            <param name="level" value="0"/>
            <param name="component" value="'SAFETY'"/>
            <param name="message" value="'Rejected takeover: ship cargo state is unavailable or uncertain'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <do_all exact="$ship.cargo.count" counter="$i">
          <set_value name="$ware" exact="$ship.cargo.{$i}"/>
          <do_if value="not $ware? or not $ware.iscargo? or not $ware.isdeployable?">
            <run_actions ref="GUNPIRE_Log">
              <param name="level" value="0"/>
              <param name="component" value="'SAFETY'"/>
              <param name="message" value="'Rejected takeover: cargo ware classification is unavailable or uncertain'"/>
            </run_actions>
            <return value="false"/>
          </do_if>
          <do_if value="$ware.iscargo and not $ware.isdeployable">
            <run_actions ref="GUNPIRE_Log">
              <param name="level" value="0"/>
              <param name="component" value="'SAFETY'"/>
              <param name="message" value="'Rejected takeover: trade cargo remains on ' + $ship.idcode"/>
            </run_actions>
            <return value="false"/>
          </do_if>
        </do_all>
        <return value="true"/>
      </actions>
    </library>
  </cues>
</mdscript>
