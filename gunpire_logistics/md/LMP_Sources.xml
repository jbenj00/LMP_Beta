<?xml version="1.0" encoding="utf-8"?>
<mdscript name="LMP_Sources" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../x4_scripting_ref/schemas/md.xsd">
  <cues>
    <!-- Uses verified find_sell_offer (common.xsd ~28283).
         Returns actual trade offers, not raw stations. -->
    <library name="LMP_FindSellOffers" purpose="run_actions">
      <params>
        <param name="ship"/>
        <param name="ware"/>
        <param name="filter" default="'both'"/>
      </params>
      <actions>
        <find_sell_offer result="$offers" multiple="true" tradepartner="$ship" space="player.galaxy" excludeempty="true" usereservations="true">
          <match_ware ware="$ware"/>
        </find_sell_offer>
        <set_value name="$filtered" exact="[]"/>
        <do_if value="$offers?">
          <do_all exact="$offers.count" counter="$i">
            <set_value name="$off" exact="$offers.{$i}"/>
            <do_if value="not $off.exists or not $off.seller?">
              <continue/>
            </do_if>
            <do_if value="$filter == 'player' and $off.seller.owner != faction.player">
              <continue/>
            </do_if>
            <do_if value="$filter == 'npc' and $off.seller.owner == faction.player">
              <continue/>
            </do_if>
            <do_if value="not $off.available or $off.amount le 0 or $ship.gatedistance.{$off.seller} lt 0 or $off.seller.ishostileto.{faction.player}">
              <continue/>
            </do_if>
            <do_if value="@$off.seller.sector.isblacklisted.{blacklisttype.sectoractivity}.{blacklistgroup.civilian}.{$ship}
                          or @$off.seller.sector.isblacklisted.{blacklisttype.sectortravel}.{blacklistgroup.civilian}.{$ship}
                          or $off.seller.isblacklisted.{blacklisttype.objectactivity}.{blacklistgroup.civilian}.{$ship}">
              <continue/>
            </do_if>
            <!-- VAS ClosestSellOffer ranking adapted to supplier offers:
                 current ship location, gate distance then physical distance. -->
            <append_to_list name="$filtered" exact="table[$offer = $off, $gates = $ship.gatedistance.{$off.seller}, $physical = $off.seller.distanceto.{$ship}]"/>
          </do_all>
        </do_if>
        <do_if value="$filtered.count gt 1">
          <sort_list list="$filtered" sortbyvalue="loop.element.$physical"/>
          <sort_list list="$filtered" sortbyvalue="loop.element.$gates"/>
        </do_if>
        <set_value name="$ranked" exact="[]"/>
        <do_for_each name="$item" in="$filtered">
          <append_to_list name="$ranked" exact="$item.$offer"/>
        </do_for_each>
        <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
          <param name="component" value="'SOURCE'"/>
          <param name="message" value="'find_sell_offer returned ' + $filtered.count + ' valid offers (filter=' + $filter + ')'"/>
        </run_actions>
        <return value="$ranked"/>
      </actions>
    </library>
  </cues>
</mdscript>
