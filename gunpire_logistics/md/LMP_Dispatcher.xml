<?xml version="1.0" encoding="utf-8"?>
<mdscript name="LMP_Dispatcher" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../x4_scripting_ref/schemas/md.xsd">
  <cues>
    <cue name="LMP_Dispatcher_Init" instantiate="true">
      <conditions>
        <event_game_loaded/>
      </conditions>
      <actions>
        <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
          <param name="component" value="'DISPATCH'"/>
          <param name="message" value="'Dispatcher online. Profile=' + (if global.$GUNPIRE_Profile? then global.$GUNPIRE_Profile else 'unset')"/>
        </run_actions>
      </actions>
    </cue>

    <library name="LMP_DispatchOne" purpose="run_actions">
      <params>
        <param name="ship"/>
      </params>
      <actions>
        <run_actions ref="md.GUNPIRE_Config.GUNPIRE_AllowsRealOrders" result="$allows"/>
        <do_if value="not $allows">
          <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'Skipped: profile forbids real orders'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <!-- Hard GT block -->
        <run_actions ref="md.GUNPIRE_Core.GUNPIRE_IsGTManagedShip" result="$isGTManaged">
          <param name="ship" value="$ship"/>
        </run_actions>
        <do_if value="$isGTManaged">
          <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'Blocked: GT ship ' + $ship.idcode"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <!-- Only explicitly enrolled PASSIVE ships; ACTIVE takeover remains blocked.
             One trip at a time, GT orders untouched. -->
        <do_if value="not global.$LMP_Ships? or not global.$LMP_Ships.{$ship}? or global.$LMP_Ships.{$ship}.$role != 'PASSIVE'">
          <return value="false"/>
        </do_if>
        <do_if value="global.$LMP_Ships.{$ship}.$job? and global.$LMP_Ships.{$ship}.$job != null">
          <return value="false"/>
        </do_if>
        <run_actions ref="md.LMP_TradeCycle.LMP_TripIsFullyFinished" result="$clear">
          <param name="ship" value="$ship"/>
        </run_actions>
        <do_if value="not $clear">
          <return value="false"/>
        </do_if>
        <!-- TEST_SINGLE_SHIP: only one controlled ship -->
        <run_actions ref="md.GUNPIRE_Config.GUNPIRE_MaxControlledShips" result="$max"/>
        <set_value name="$controlled" exact="0"/>
        <do_if value="global.$LMP_Ships?">
          <do_all exact="global.$LMP_Ships.keys.count" counter="$ci">
            <set_value name="$s" exact="global.$LMP_Ships.keys.{$ci}"/>
            <do_if value="global.$LMP_Ships.{$s}.$state == 'PURCHASING' or global.$LMP_Ships.{$s}.$state == 'DELIVERING'">
              <set_value name="$controlled" exact="$controlled + 1"/>
            </do_if>
          </do_all>
        </do_if>
        <do_if value="$controlled ge $max">
          <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'Blocked: profile ship limit ' + $max + ' reached'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <run_actions ref="md.LMP_Demand.LMP_ScanBuildStorages" result="$demand">
          <param name="ship" value="$ship"/>
        </run_actions>
        <do_if value="$demand.keys.count == 0">
          <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'No build storages'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <!-- Never fabricate demand: source must report a positive shortage. -->
        <do_if value="not global.$LMP_Shortages? or global.$LMP_Shortages.keys.count == 0">
          <return value="false"/>
        </do_if>
        <set_value name="$sk" exact="global.$LMP_Shortages.keys.{1}"/>
        <set_value name="$site" exact="global.$LMP_Shortages.{$sk}.$site"/>
        <set_value name="$ware" exact="global.$LMP_Shortages.{$sk}.$ware"/>
        <set_value name="$qty" exact="global.$LMP_Shortages.{$sk}.$qty"/>
        <set_value name="$targetOffer" exact="global.$LMP_Shortages.{$sk}.$offer"/>
        <!-- Reduce outstanding need by reservations from other in-flight trips. -->
        <do_if value="global.$LMP_Reservations?">
          <do_all exact="global.$LMP_Reservations.keys.count" counter="$ri">
            <set_value name="$rk" exact="global.$LMP_Reservations.keys.{$ri}"/>
            <set_value name="$res" exact="global.$LMP_Reservations.{$rk}"/>
            <do_if value="$res.$site == $site and $res.$ware == $ware">
              <set_value name="$qty" exact="$qty - $res.$qty"/>
            </do_if>
          </do_all>
        </do_if>
        <do_if value="not $site? or not $ware? or not $targetOffer? or not $targetOffer.exists or $qty le 0">
          <return value="false"/>
        </do_if>
        <run_actions ref="md.LMP_Sources.LMP_FindSellOffers" result="$offers">
          <param name="ship" value="$ship"/>
          <param name="ware" value="$ware"/>
          <param name="filter" value="'both'"/>
        </run_actions>
        <do_if value="not $offers? or $offers.count == 0">
          <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'No sell offers for selected ware'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <set_value name="$offer" exact="$offers.{1}"/>
        <set_value name="$qty" exact="[$qty, $offer.amount].min"/>
        <set_value name="$qty" exact="[$qty, $targetOffer.amount].min"/>
        <set_value name="$maxCargoQty" exact="($ship.cargo.free.container / $ware.volume).floor"/>
        <set_value name="$qty" exact="[$qty, $maxCargoQty].min"/>
        <do_if value="$qty le 0">
          <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'Offer amount zero; skipping'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <set_value name="$job" exact="'JOB-' + $ship.idcode"/>
        <run_actions ref="md.LMP_Reservations.LMP_Reserve" result="$reserved">
          <param name="ship" value="$ship"/>
          <param name="site" value="$site"/>
          <param name="ware" value="$ware"/>
          <param name="qty" value="$qty"/>
          <param name="job" value="$job"/>
        </run_actions>
        <do_if value="not $reserved">
          <return value="false"/>
        </do_if>
        <run_actions ref="md.LMP_TradeCycle.LMP_QueuePairedTrade" result="$trip">
          <param name="ship" value="$ship"/>
          <param name="sourceOffer" value="$offer"/>
          <param name="targetOffer" value="$targetOffer"/>
          <param name="amount" value="$qty"/>
        </run_actions>
        <set_value name="$ok" exact="$trip? and $trip.$buy? and $trip.$deliver?"/>
        <do_if value="not $ok">
          <!-- A purchase can already be queued when second order creation fails.
               Keep the reservation and quarantine until manual reconciliation. -->
          <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'QUARANTINED'"/>
          <set_value name="global.$LMP_Ships.{$ship}.$job" exact="$job"/>
          <return value="false"/>
        </do_if>
        <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'PURCHASING'"/>
        <set_value name="global.$LMP_Ships.{$ship}.$job" exact="$job"/>
        <set_value name="global.$LMP_Ships.{$ship}.$buyOrder" exact="$trip.$buy"/>
        <set_value name="global.$LMP_Ships.{$ship}.$deliverOrder" exact="$trip.$deliver"/>
        <return value="true"/>
      </actions>
    </library>
  </cues>
</mdscript>
