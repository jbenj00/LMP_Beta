<?xml version="1.0" encoding="utf-8"?>
<mdscript name="LMP_Dispatcher" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../x4_scripting_ref/schemas/md.xsd">
  <cues>
    <cue name="LMP_Dispatcher_Init" instantiate="true">
      <conditions>
        <event_game_loaded/>
      </conditions>
      <actions>
        <run_actions ref="GUNPIRE_Log">
          <param name="component" value="'DISPATCH'"/>
          <param name="message" value="'Dispatcher online. Profile=' + (if global.$GUNPIRE_Profile? then global.$GUNPIRE_Profile else 'unset')"/>
        </run_actions>
      </actions>
    </cue>

    <library name="LMP_DispatchOne" purpose="run_actions">
      <params>
        <param name="ship"/>
      </params>
      <actions>
        <run_actions ref="GUNPIRE_LifecycleReadyForExecution" result="$lifecycleReady"/>
        <do_if value="not $lifecycleReady">
          <run_actions ref="GUNPIRE_Log">
            <param name="level" value="0"/>
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'Blocked: purchase, destination deposit, and confirmation lifecycle is not verified'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <run_actions ref="GUNPIRE_AllowsRealOrders" result="$allows"/>
        <do_if value="not $allows">
          <run_actions ref="GUNPIRE_Log">
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'Skipped: profile forbids real orders'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <!-- Hard GT block -->
        <do_if value="$ship.defaultorder? and ($ship.defaultorder.id == 'GalaxyTraderMK3' or $ship.defaultorder.id == 'GalaxyTraderMK1' or $ship.defaultorder.id == 'GalaxyTraderMK2' or $ship.defaultorder.id == 'GalaxyTraderMK4' or $ship.defaultorder.id == 'GalaxyTraderMK42')">
          <run_actions ref="GUNPIRE_Log">
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'Blocked: GT ship ' + $ship.idcode"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <!-- TEST_SINGLE_SHIP: only one controlled ship -->
        <run_actions ref="GUNPIRE_MaxControlledShips" result="$max"/>
        <set_value name="$controlled" exact="0"/>
        <do_if value="global.$LMP_Ships?">
          <do_all exact="global.$LMP_Ships.keys.count" counter="$ci">
            <set_value name="$s" exact="global.$LMP_Ships.keys.{$ci}"/>
            <do_if value="global.$LMP_Ships.{$s}.$state == 'PURCHASING' or global.$LMP_Ships.{$s}.$state == 'DELIVERING'">
              <set_value name="$controlled" exact="$controlled + 1"/>
            </do_if>
          </do_all>
        </do_if>
        <do_if value="$controlled ge $max">
          <run_actions ref="GUNPIRE_Log">
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'Blocked: profile ship limit ' + $max + ' reached'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <run_actions ref="LMP_ScanBuildStorages" result="$demand"/>
        <do_if value="$demand.keys.count == 0">
          <run_actions ref="GUNPIRE_Log">
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'No build storages'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <!-- Dispatch only a documented shortage; never invent a probe ware or quantity. -->
        <set_value name="$ware" exact="null"/>
        <set_value name="$site" exact="null"/>
        <set_value name="$qty" exact="0"/>
        <do_if value="global.$LMP_Shortages? and global.$LMP_Shortages.keys.count gt 0">
          <set_value name="$sk" exact="global.$LMP_Shortages.keys.{1}"/>
          <set_value name="$site" exact="global.$LMP_Shortages.{$sk}.$site"/>
          <set_value name="$ware" exact="global.$LMP_Shortages.{$sk}.$ware"/>
          <set_value name="$qty" exact="global.$LMP_Shortages.{$sk}.$qty"/>
        </do_if>
        <do_if value="not $ware? or not $site? or $qty le 0">
          <run_actions ref="GUNPIRE_Log">
            <param name="level" value="0"/>
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'Blocked: no concrete, positive build-storage shortage is available'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <run_actions ref="LMP_FindSellOffers" result="$offers">
          <param name="ship" value="$ship"/>
          <param name="ware" value="$ware"/>
          <param name="filter" value="'both'"/>
        </run_actions>
        <do_if value="not $offers? or $offers.count == 0">
          <run_actions ref="GUNPIRE_Log">
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'No sell offers for selected ware'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <set_value name="$offer" exact="$offers.{1}"/>
        <set_value name="$qty" exact="[$qty, $offer.offeramount].min"/>
        <do_if value="$qty le 0">
          <run_actions ref="GUNPIRE_Log">
            <param name="component" value="'DISPATCH'"/>
            <param name="message" value="'Offer amount zero; skipping'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <set_value name="$job" exact="'JOB-' + $ship.idcode + '-' + global.$GUNPIRE_SessionId + '-' + player.age"/>
        <run_actions ref="LMP_Reserve" result="$reserved">
          <param name="ship" value="$ship"/>
          <param name="site" value="$site"/>
          <param name="ware" value="$ware"/>
          <param name="qty" value="$qty"/>
          <param name="job" value="$job"/>
        </run_actions>
        <do_if value="not $reserved">
          <run_actions ref="GUNPIRE_Log">
            <param name="level" value="0"/>
            <param name="component" value="'DISPATCH'"/>
            <param name="job" value="$job"/>
            <param name="message" value="'Blocked: reservation could not be established; no order created'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <run_actions ref="LMP_CreateTradeOrder" result="$ok">
          <param name="ship" value="$ship"/>
          <param name="tradeoffer" value="$offer"/>
          <param name="amount" value="$qty"/>
          <param name="job" value="$job"/>
        </run_actions>
        <do_if value="not $ok">
          <set_value name="$reservationKey" exact="'$' + $job"/>
          <set_value name="global.$LMP_Reservations.{$reservationKey}.$state" exact="'RECONCILIATION_REQUIRED'"/>
          <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'RECONCILIATION_REQUIRED'"/>
          <run_actions ref="GUNPIRE_Log">
            <param name="level" value="0"/>
            <param name="component" value="'DISPATCH'"/>
            <param name="job" value="$job"/>
            <param name="message" value="'Order result is uncertain; reservation retained for safe reconciliation'"/>
          </run_actions>
        </do_if>
        <return value="$ok"/>
      </actions>
    </library>
  </cues>
</mdscript>
