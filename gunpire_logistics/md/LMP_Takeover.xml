<?xml version="1.0" encoding="utf-8"?>
<mdscript name="LMP_Takeover" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../x4_scripting_ref/schemas/md.xsd">
  <cues>
    <!-- Snapshot and handoff. No default-order swap until cooperative GT path verified. -->
    <library name="LMP_SnapshotShip" purpose="run_actions">
      <params>
        <param name="ship"/>
      </params>
      <actions>
        <do_if value="not $ship? or not $ship.exists or not global.$LMP_Ships? or not global.$LMP_Ships.{$ship}?">
          <return value="false"/>
        </do_if>
        <!-- A saved GT snapshot is evidence of a pending handoff. Never
             replace it with a newer snapshot without a verified restore. -->
        <do_if value="global.$LMP_Ships.{$ship}.$snapshot? and global.$LMP_Ships.{$ship}.$snapshot != null">
          <return value="false"/>
        </do_if>
        <set_value name="$snap" exact="table[]"/>
        <set_value name="$snap.$idcode" exact="$ship.idcode"/>
        <set_value name="$snap.$commander" exact="if $ship.commander? then $ship.commander else null"/>
        <set_value name="$snap.$home" exact="if $ship.home? then $ship.home else null"/>
        <set_value name="$snap.$defaultOrderId" exact="if $ship.defaultorder? then $ship.defaultorder.id else null"/>
        <!-- Read-only GT progression baseline. GT 1.0.4 stores pilot XP
             and level in global.$GT_Pilots, keyed by ship.pilot.
             Capturing these values does NOT constitute restoration. -->
        <set_value name="$snap.$pilot" exact="if $ship.pilot? then $ship.pilot else null"/>
        <set_value name="$snap.$gtRegistered" exact="global.$GT_Ships? and global.$GT_Ships.{$ship}?"/>
        <do_if value="$ship.pilot? and global.$GT_Pilots? and global.$GT_Pilots.{$ship.pilot}?">
          <set_value name="$pilotData" exact="global.$GT_Pilots.{$ship.pilot}"/>
          <set_value name="$snap.$gtXP" exact="if $pilotData.$XP? then $pilotData.$XP else null"/>
          <set_value name="$snap.$gtLevel" exact="if $pilotData.$Level? then $pilotData.$Level else null"/>
          <set_value name="$snap.$gtPilotShip" exact="if $pilotData.$Ship? then $pilotData.$Ship else null"/>
        </do_if>
        <set_value name="$snap.$captured" exact="player.age"/>
        <set_value name="global.$LMP_Ships.{$ship}.$snapshot" exact="$snap"/>
        <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'SNAPSHOTTED'"/>
        <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
          <param name="component" value="'TAKEOVER'"/>
          <param name="message" value="'Snapshot captured for ' + $ship.idcode"/>
        </run_actions>
        <return value="true"/>
      </actions>
    </library>

    <library name="LMP_RequestTakeover" purpose="run_actions">
      <params>
        <param name="ship"/>
      </params>
      <actions>
        <!-- Hard gates -->
        <run_actions ref="md.LMP_ShipRegistry.LMP_IsEnrolled" result="$enrolled">
          <param name="ship" value="$ship"/>
        </run_actions>
        <do_if value="not $enrolled">
          <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
            <param name="component" value="'TAKEOVER'"/>
            <param name="message" value="'Rejected: not enrolled ' + (if $ship? then $ship.idcode else 'null')"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <run_actions ref="md.GUNPIRE_Config.GUNPIRE_AllowsRealOrders" result="$allows"/>
        <do_if value="not $allows">
          <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
            <param name="component" value="'TAKEOVER'"/>
            <param name="message" value="'Rejected: profile forbids real orders'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <!-- ACTIVE borrowing is restricted to explicitly enrolled GT
             ships. PASSIVE and other trader defaults remain untouched. -->
        <do_if value="not $ship? or not $ship.exists or not $ship.isplayerowned or not global.$LMP_Ships? or not global.$LMP_Ships.{$ship}? or global.$LMP_Ships.{$ship}.$role != 'ACTIVE'">
          <return value="false"/>
        </do_if>
        <run_actions ref="md.GUNPIRE_Core.GUNPIRE_IsGTManagedShip" result="$gt">
          <param name="ship" value="$ship"/>
        </run_actions>
        <do_if value="not $gt">
          <return value="false"/>
        </do_if>
        <do_if value="global.$LMP_Ships.{$ship}.$job? and global.$LMP_Ships.{$ship}.$job != null">
          <return value="false"/>
        </do_if>
        <do_if value="global.$LMP_Ships.{$ship}.$snapshot? and global.$LMP_Ships.{$ship}.$snapshot != null">
          <return value="false"/>
        </do_if>
        <do_if value="$ship.tradeorders? and $ship.tradeorders.count gt 0">
          <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'WAITING_FOR_ELIGIBILITY'"/>
          <return value="false"/>
        </do_if>
        <!-- GT itself checks ship.orders separately from tradeorders.
             An empty cargo hold does not make queued non-trade work safe
             to interrupt. This is a non-mutating eligibility gate. -->
        <do_if value="$ship.orders? and $ship.orders.count gt 0">
          <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'WAITING_FOR_ELIGIBILITY'"/>
          <return value="false"/>
        </do_if>
        <!-- Cargo / active job check: exact API pending; currently conservative -->
        <run_actions ref="md.GUNPIRE_Core.GUNPIRE_SafetyCheckCargoEmpty" result="$empty">
          <param name="ship" value="$ship"/>
        </run_actions>
        <do_if value="not $empty">
          <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'WAITING_FOR_ELIGIBILITY'"/>
          <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
            <param name="component" value="'TAKEOVER'"/>
            <param name="message" value="'Waiting for eligibility ' + $ship.idcode"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <run_actions ref="md.LMP_Takeover.LMP_SnapshotShip" result="$ok">
          <param name="ship" value="$ship"/>
        </run_actions>
        <do_if value="not $ok">
          <return value="false"/>
        </do_if>
        <!-- GT permanent-removal gate: do not assign LMP default order until cooperative path verified -->
        <run_actions ref="md.GUNPIRE_Core.GUNPIRE_Log">
          <param name="component" value="'TAKEOVER'"/>
          <param name="message" value="'Snapshot OK but GT cooperative handoff not verified — takeover blocked for ' + $ship.idcode"/>
        </run_actions>
        <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'BLOCKED_GT_HANDOFF'"/>
        <return value="false"/>
      </actions>
    </library>
  </cues>
</mdscript>
