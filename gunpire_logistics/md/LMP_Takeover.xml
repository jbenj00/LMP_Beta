<?xml version="1.0" encoding="utf-8"?>
<mdscript name="LMP_Takeover" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../x4_scripting_ref/schemas/md.xsd">
  <cues>
    <!-- Snapshot and handoff. No default-order swap until cooperative GT path verified. -->
    <library name="LMP_SnapshotShip" purpose="run_actions">
      <params>
        <param name="ship"/>
      </params>
      <actions>
        <do_if value="not $ship? or not $ship.exists">
          <return value="false"/>
        </do_if>
        <run_actions ref="GUNPIRE_LifecycleReadyForExecution" result="$ready"/>
        <do_if value="not $ready">
          <run_actions ref="GUNPIRE_Log">
            <param name="level" value="0"/>
            <param name="component" value="'TAKEOVER'"/>
            <param name="message" value="'Snapshot blocked: complete behavior, parameters, orders, commander, and restoration contract is unverified for ' + $ship.idcode"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <return value="false"/>
      </actions>
    </library>

    <library name="LMP_RequestTakeover" purpose="run_actions">
      <params>
        <param name="ship"/>
      </params>
      <actions>
        <!-- Hard gates -->
        <run_actions ref="LMP_IsEnrolled" result="$enrolled">
          <param name="ship" value="$ship"/>
        </run_actions>
        <do_if value="not $enrolled">
          <run_actions ref="GUNPIRE_Log">
            <param name="component" value="'TAKEOVER'"/>
            <param name="message" value="'Rejected: not enrolled ' + (if $ship? then $ship.idcode else 'null')"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <run_actions ref="GUNPIRE_AllowsRealOrders" result="$allows"/>
        <do_if value="not $allows">
          <run_actions ref="GUNPIRE_Log">
            <param name="component" value="'TAKEOVER'"/>
            <param name="message" value="'Rejected: profile forbids real orders'"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <do_if value="$ship.defaultorder? and ($ship.defaultorder.id == 'GalaxyTraderMK3' or $ship.defaultorder.id == 'GalaxyTraderMK1' or $ship.defaultorder.id == 'GalaxyTraderMK2' or $ship.defaultorder.id == 'GalaxyTraderMK4' or $ship.defaultorder.id == 'GalaxyTraderMK42')">
          <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'BLOCKED_GT_UNSUPPORTED'"/>
          <run_actions ref="GUNPIRE_Log">
            <param name="level" value="0"/>
            <param name="component" value="'TAKEOVER'"/>
            <param name="message" value="'Hard-blocked Galaxy Trader 1.0.4 takeover for ' + $ship.idcode"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <run_actions ref="GUNPIRE_SafetyCheckCargoEmpty" result="$empty">
          <param name="ship" value="$ship"/>
        </run_actions>
        <do_if value="not $empty">
          <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'BLOCKED_CARGO_STATE_UNVERIFIED'"/>
          <run_actions ref="GUNPIRE_Log">
            <param name="level" value="0"/>
            <param name="component" value="'TAKEOVER'"/>
            <param name="message" value="'Rejected takeover: cargo is nonempty or cargo state is uncertain for ' + $ship.idcode"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <run_actions ref="GUNPIRE_LifecycleReadyForExecution" result="$ready"/>
        <do_if value="not $ready">
          <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'BLOCKED_LIFECYCLE_UNVERIFIED'"/>
          <run_actions ref="GUNPIRE_Log">
            <param name="level" value="0"/>
            <param name="component" value="'TAKEOVER'"/>
            <param name="message" value="'Rejected takeover: non-GT snapshot, order, and restoration contracts are unverified for ' + $ship.idcode"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <run_actions ref="LMP_SnapshotShip" result="$ok">
          <param name="ship" value="$ship"/>
        </run_actions>
        <do_if value="not $ok">
          <set_value name="global.$LMP_Ships.{$ship}.$state" exact="'BLOCKED_SNAPSHOT_UNVERIFIED'"/>
          <return value="false"/>
        </do_if>
        <return value="false"/>
      </actions>
    </library>
  </cues>
</mdscript>
