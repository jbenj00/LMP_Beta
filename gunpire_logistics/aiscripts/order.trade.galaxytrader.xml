<?xml version="1.0" encoding="utf-8"?>
<diff>
  <!-- Galaxy Trader MK3 v1.0.4, X4 9.00.
       One unambiguous insertion immediately after MK3 queues its own BUY
       order, inside the original validated non-sell-only trade branch.
       Opt-in global execution flag is FALSE by default in GUNPIRE.
       GT's original orders, account, progression, and control flow remain.
       If GT changes this exact command the patch must fail closed. -->
  <add sel="//create_trade_order[@object='this.ship'][@tradeoffer='$pendingTrade.$BuyOffer'][@amount='$finalBuyAmount']" pos="after">
    <do_if value="global.$LMP_Wing_ExecuteEnabled? and global.$LMP_Wing_ExecuteEnabled and global.$LMP_Wings? and global.$LMP_Wings.{this.ship}? and global.$LMP_Wings.{this.ship}.$executeEnabled? and global.$LMP_Wings.{this.ship}.$executeEnabled">
      <run_script name="'lib.lmp.wing.extend'" result="$lmpWingExtend">
        <param name="commander" value="this.ship"/>
        <param name="buyStation" value="$finalBuyStation"/>
        <param name="sellStation" value="$finalSellStation"/>
        <param name="ware" value="$wareForPendingTrade"/>
        <param name="additionalTarget" value="0"/>
        <param name="buyInternal" value="$tradeBuyLegInternal"/>
        <param name="sellInternal" value="$tradeSellLegInternal"/>
      </run_script>
      <debug_text text="'[GUNPIRE][WING] MK3 additional orders queued=' + $lmpWingExtend.$Assigned + ' ships=' + $lmpWingExtend.$Ships" chance="100"/>
    </do_if>
  </add>
</diff>
